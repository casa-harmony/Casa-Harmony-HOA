# ─── Casa Harmony AI — Backend environment ────────────────────────────────
# Copy to .env and adjust. NEVER commit the real .env.

# --- Application ---
APP_NAME="Casa Harmony AI"
ENVIRONMENT=development                 # development | staging | production
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ---
# The application connects as a NON-superuser role so PostgreSQL Row-Level
# Security is actually enforced (a superuser/BYPASSRLS role would skip policies).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=casa_harmony
POSTGRES_USER=casa_app
POSTGRES_PASSWORD=casa_app_pwd
# Optional full override (takes precedence if set):
# DATABASE_URL=postgresql+psycopg://casa_app:casa_app_pwd@localhost:5432/casa_harmony

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_dev_only_super_secret_key_rotate_in_prod
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Field-level encryption key (Fernet). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=CHANGE_ME_generate_a_real_fernet_key_in_production=

# --- Bootstrap SUPERADMIN (used only by scripts/seed.py) ---
SUPERADMIN_EMAIL=superadmin@casaharmony.ai
SUPERADMIN_PASSWORD=ChangeMe!Superadmin1

# --- Outbound links ---
# Goes into resident invites, password-reset links and statement links. Left at
# localhost, those emails point the recipient at their own machine — so the API
# refuses to boot with a localhost value when ENVIRONMENT=production.
FRONTEND_BASE_URL=http://localhost:3000

# --- Test Inbox (docs/COMMUNITIES.md) ---
# Captures every outbound email/SMS so invite links and OTPs can be read at
# /inbox without a real mailbox. Holds live tokens in the clear, so it is
# SUPERADMIN-only and off in production unless this is explicitly true.
# DEV_MAILBOX_ENABLED=true
# DEV_MAILBOX_MAX_MESSAGES=500
