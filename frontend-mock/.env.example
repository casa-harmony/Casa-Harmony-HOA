# Base URL of the Casa Harmony FastAPI backend (include the /api/v1 prefix).
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# Transport: mock (in-browser demo store, the safe default) or live (real API).
# Compiled into the bundle at build time — set it in the Docker build (e.g. a
# Railway service variable) and redeploy for it to take effect.
NEXT_PUBLIC_DATA_MODE=mock

# ---------------------------------------------------------------------------
# Review mode — client commenting on the deployed demo.
#
# With REVIEW_PASSCODE unset the whole feature is inert: no UI, no requests,
# ordinary website. Set it, and visiting /?review=<passcode> unlocks commenting
# on that browser for 90 days.
# ---------------------------------------------------------------------------
REVIEW_PASSCODE=

# Postgres for the comments. Neon, Supabase's pooler, or any Postgres URL.
# Tables are created automatically on first use.
DATABASE_URL=

# Cloudinary, for screenshots and files attached to a comment.
# Either the three values below, or the single CLOUDINARY_URL — both work.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=casa-harmony/review
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
